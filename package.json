{
  "name": "todo-app-with-api",
  "version": "0.1.0",
  "private": true,
  "keywords": [],
  "author": "AlucardYagamiGame",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.5.2",
    "bulma": "^1.0.1",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.5"
  },
  "devDependencies": {
    "@cypress/react18": "^2.0.1",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-transition-group": "^4.4.10",
    "@typescript-eslint/parser": "^7.16.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cypress": "^13.13.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^3.3.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.1.1",
    "mochawesome": "^7.1.3",
    "prettier": "^3.3.2",
    "sass": "^1.77.8",
    "stylelint": "^16.7.0",
    "stylelint-config-clean-order": "^7.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-scss": "^6.11.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  },
  "scripts": {
    "start": "vite --port 3000",
    "build": "vite build --base=/todo-app-with-api/",
    "preview": "vite preview --port 3000",
    "test": "cypress run",
    "cypress": "cypress open",
    "typecheck": "tsc --noEmit",
    "style-format": "stylelint \"src/**/*.scss\" --fix --allow-empty-input",
    "format": "prettier --write \"./src/**/*.{ts,tsx}\"",
    "lint-js": "eslint ./src --ext .ts,.tsx,.js,.jsx --fix",
    "lint-css": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "lint": "npm run style-format && npm run format && npm run lint-js && npm run lint-css && npm run typecheck",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
